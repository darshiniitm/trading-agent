# Copy to .env (gitignored). Use the real password; for IPv4-only networks use the Session pooler string
# from Supabase dashboard -> Connect (postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.eelonzthtzdtpttkyeff.supabase.co:5432/postgres
DATA_BACKEND=file

# --- Interpreter LLM (frontend/apps/web/src/server/llm) ---
# Local dev keeps local Ollama. Production uses Ollama Cloud: same /api/chat API, host + Bearer key differ.
LLM_PROVIDER=local              # local | cloud
OLLAMA_HOST=                    # empty = http://127.0.0.1:11434 (local) / https://ollama.com (cloud)
OLLAMA_API_KEY=                 # cloud only; create at ollama.com/settings/keys. Never commit. Prod: host secret store.
OLLAMA_MODEL=gemma4:31b         # verify the exact cloud id via GET https://ollama.com/api/tags
OLLAMA_FALLBACK_MODELS=         # cloud only, comma-separated, tried in order. A fallback model needs its own golden-suite pass first.
LLM_TIMEOUT_MS=8000             # cloud only. Thinking tasks may need more: LLM_TIMEOUT_MS_MODELREAD / _CRITIC / _CURATE
LLM_MAX_RETRIES=1               # cloud only; one jittered retry on 429/5xx/timeout, then the next fallback model

# --- Observability (Part B; see observability/README.md). Everything below is OFF unless set. ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp   # Grafana Cloud; traces + metrics + logs from the app AND the engine
# OTEL_EXPORTER_OTLP_HEADERS=                          # python -m observability.cloud headers   (see observability/README.md)
# TELEMETRY_DB_URL=                                    # run records -> observability.* (falls back to SUPABASE_DB_URL); needs migration 0010
# TELEMETRY_HASH_SALT=                                 # HMAC salt for hashed user ids (set a long random value in prod)
# TELEMETRY_STDOUT_LOGS=1                              # also print the structured start/end lines as JSON
# TELEMETRY_DISABLED=1                                 # hard off
# (weekly-job gauges and golden_suite_accuracy use the same OTEL_EXPORTER_OTLP_* settings)
