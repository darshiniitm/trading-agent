{
  "uid": "ps-interpreter-quality",
  "title": "Interpreter quality",
  "description": "golden_suite_accuracy pushed by the eval scripts, local vs cloud, against the 97% target.",
  "tags": [
    "prompt-screener",
    "quality"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Golden-suite accuracy",
      "description": "The red line is the 97% target. Values are the latest pushed result, held for 30 days with last_over_time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.97
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max by (provider, model, suite_version) (last_over_time(golden_suite_accuracy[30d]))",
          "legendFormat": "{{provider}} {{model}} ({{suite_version}})",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest cloud accuracy",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.97
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "min(last_over_time(golden_suite_accuracy{provider=\"cloud\"}[30d]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latest local accuracy",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.97
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "min(last_over_time(golden_suite_accuracy{provider=\"local\"}[30d]))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Cutover gate (plan A4): cloud accuracy >= local, p95 interpreter latency <= 5 s, zero unparseable JSON. Latency and bad-JSON are on *LLM health* and *Prompt pipeline*; `results/llm-parity/gate.json` holds the last gate decision."
      }
    }
  ]
}
