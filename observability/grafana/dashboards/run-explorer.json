{
  "uid": "ps-run-explorer",
  "title": "Run explorer",
  "description": "Pick a prompt id or run id: every task, agent call and tool call with status, duration, tokens and expandable input/output. Rows link to the trace and its logs.",
  "tags": [
    "prompt-screener",
    "runs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "prompt_id",
        "label": "Prompt id",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "supabase"
        },
        "query": "select distinct prompt_id::text from observability.runs where prompt_id is not null order by 1 desc limit 200",
        "refresh": 2,
        "includeAll": true,
        "allValue": "%",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "sort": 0
      },
      {
        "type": "query",
        "name": "run_id",
        "label": "Run",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "supabase"
        },
        "query": "select run_id::text as __value, concat(to_char(started_at, 'MM-DD HH24:MI'), ' ', kind, ' ', status, ' p', coalesce(prompt_id::text, '-')) as __text from observability.runs where coalesce(prompt_id::text, '') like '$prompt_id' or '$prompt_id' = '%' order by started_at desc limit 200",
        "refresh": 2,
        "includeAll": true,
        "allValue": "%",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "sort": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Runs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace in Tempo",
                    "url": "/explore?orgId=1&left={%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22datasource%22%3A{%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22}%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22}%5D%2C%22range%22%3A{%22from%22%3A%22now-24h%22%2C%22to%22%3A%22now%22}}",
                    "targetBlank": true
                  },
                  {
                    "title": "Logs for this trace in Loki",
                    "url": "/explore?orgId=1&left={%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22datasource%22%3A{%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22}%2C%22expr%22%3A%22{service_name%3D~%5C%22.%2B%5C%22}%20%7C%20trace_id%20%3D%20%5C%22${__value.raw}%5C%22%22}%5D%2C%22range%22%3A{%22from%22%3A%22now-24h%22%2C%22to%22%3A%22now%22}}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select started_at, kind, status, outcome, prompt_id, draft_id, user_hash, provider, model, duration_ms, error_type, error_msg, trace_id, run_id::text as run_id from observability.runs where coalesce(prompt_id::text, '') like '$prompt_id' or '$prompt_id' = '%' order by started_at desc limit 200"
        }
      ]
    },
