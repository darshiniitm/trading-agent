      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (agent) (rate(agent_invocations_total[5m])) * 60",
          "legendFormat": "{{agent}}",
          "range": true
        }
