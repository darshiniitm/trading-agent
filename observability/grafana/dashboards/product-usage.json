{
  "uid": "ps-product-usage",
  "title": "Product usage",
  "description": "From the run records in Supabase (observability.*). User ids are HMAC hashes. Watchlist sizes and per-condition usage live in the app's own SQLite store, not here.",
  "tags": [
    "prompt-screener",
    "product"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Prompt runs per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select date_trunc('day', started_at) as time, count(*) as runs from observability.runs where kind='prompt_run' and $__timeFilter(started_at) group by 1 order by 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active users per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select date_trunc('day', started_at) as time, count(distinct user_hash) as users from observability.runs where kind='prompt_run' and $__timeFilter(started_at) group by 1 order by 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Confirmed prompts (range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) from observability.runs where kind='prompt_run' and status='ok' and $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed confirms (range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) from observability.runs where kind='prompt_run' and status='error' and $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg stocks screened -> kept",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select round(avg(rows_out)::numeric, 1) from observability.tool_calls where tool_name='screen.filter' and $__timeFilter(started_at)"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Most-used tools",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select tool_name, count(*) as calls, round(avg(duration_ms)) as avg_ms, count(*) filter (where status='error') as errors from observability.tool_calls where $__timeFilter(started_at) group by 1 order by 2 desc limit 20"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Most-used agents",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "supabase"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "supabase"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select agent_name, count(*) as calls, round(avg(duration_ms)) as avg_ms, sum(input_tokens) as input_tokens, sum(output_tokens) as output_tokens from observability.agent_calls where $__timeFilter(started_at) group by 1 order by 2 desc"
        }
      ]
    }
  ]
}
