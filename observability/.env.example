# Copy to observability/.env (gitignored). Read by `python -m observability.cloud`; the app / engine / jobs read the OTEL_* lines from
# their own environment (root .env or frontend/apps/web/.env.local) -- copy those two lines there. NEVER paste these values into chat.

# --- 1. SENDING telemetry (app + engine + weekly jobs + evals) -------------------------------------------------------------------
# Grafana Cloud > your stack > OpenTelemetry > Configure: shows the OTLP endpoint, the instance ID, and lets you create a token
# (an access-policy token with metrics:write, logs:write, traces:write).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=
GRAFANA_OTLP_TOKEN=
# Build this line with:  python -m observability.cloud headers   (it base64-encodes instance-id:token for you)
OTEL_EXPORTER_OTLP_HEADERS=

# --- 2. SYNCING dashboards / alerts / datasource (python -m observability.cloud sync [--apply]) ----------------------------------
# Grafana Cloud > your stack > Administration > Users and access > Service accounts: create one (Admin role is simplest: it must write
# dashboards, datasources and alert provisioning), then "Add service account token".
GRAFANA_URL=https://YOURSTACK.grafana.net
GRAFANA_SA_TOKEN=

# Read-only Postgres role for the Run explorer / Product usage panels. The migration creates `grafana_ro` NOLOGIN; give it a password
# out of band (alter role grafana_ro login password '...';) and use the Supabase *pooler* host. Restrict by IP in Supabase if you can.
# Through the pooler the user name must carry the project ref:  grafana_ro.<project-ref>  (a plain "grafana_ro" only works on the direct host).
GRAFANA_PG_HOST=aws-0-REGION.pooler.supabase.com:5432
GRAFANA_PG_DATABASE=postgres
GRAFANA_PG_USER=grafana_ro.YOUR_PROJECT_REF
GRAFANA_PG_PASSWORD=

# Alert contact point is a PLACEHOLDER webhook until the channel (email / Telegram / Slack) is chosen.
ALERT_WEBHOOK_URL=https://example.invalid/grafana-alert

# Weekly Ollama Cloud budget in GPU-seconds for the "cloud budget" alert (fires at 80%). The huge default keeps it quiet until real usage is measured.
LLM_WEEKLY_GPU_SECONDS_BUDGET=1000000000
