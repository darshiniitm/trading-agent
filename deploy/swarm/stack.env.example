# Copy to /srv/screener/stack.env on the VM (non-secret values only). deploy.sh sources it before `docker stack deploy`.
ENGINE_DOMAIN=engine.example.com
ACME_EMAIL=you@example.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp

# Backups + image source (deploy-digest.sh, backup-pgdump.sh)
GHCR_REPO=ghcr.io/OWNER/trading-agent
BACKUP_BUCKET=gs://engine-backups
