# Names only: set the values in Netlify -> Site configuration -> Environment variables
# (mark secrets as "secret", scope them to Functions). Never commit values.
# Plan: docs/netlify-production-plan.md §6.4

APP_ENV=production
APP_URL=                              # https://<site>.netlify.app or the custom domain

# Supabase (the PRODUCTION project; Deploy Previews use the staging project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # only if the owner-invite page is turned on; server-only
OWNER_EMAIL=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# App database: Supabase TRANSACTION pooler (port 6543). The role's search_path must include screener_app (migration 0011 sets it).
APP_DB_URL=                           # postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
APP_DB_SSL=                           # "no-verify" if the pooler's certificate is rejected
TELEMETRY_DB_URL=                     # same project, 6543

# Interpreter LLM (Ollama Cloud)
LLM_PROVIDER=cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_FALLBACK_MODELS=
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=

# Long requests: "background" runs compile/screen in a Netlify background function (15 min) and the page polls /api/jobs/:id.
# Leave unset (synchronous, 60 s limit, 50 s model budget) until the Ollama Cloud timing run says it is needed (plan §6.2).
LONG_REQUESTS=
JOB_SECRET=                           # random string shared by the app and the background function; required when LONG_REQUESTS=background
COMPILE_DEADLINE_MS=                  # optional override of the model time budget (default 50000 on Netlify)

# Screening engine (separate always-on service)
ENGINE_MANAGED=0                      # also forced off whenever NETLIFY is set
ENGINE_BASE_URL=                      # https://<engine-host>
ENGINE_TOKEN=

# Observability (Grafana Cloud OTLP)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_SERVICE_NAME=prompt-screener-web
OTEL_RESOURCE_ATTRIBUTES=
TELEMETRY_HASH_SALT=

# NOT needed in production: HF_TOKEN, OPENROUTER_API_KEY, GRAFANA_API_KEY / GRAFANA_SA_TOKEN / GRAFANA_URL (provisioning tools,
# run from a laptop), SUPABASE_DB_URL (Python warehouse only)
