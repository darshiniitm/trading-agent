# Copy to .env.local (never commit). See docs/login-auth-setup.md.
NEXT_PUBLIC_SUPABASE_URL=https://eelonzthtzdtpttkyeff.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; reserved for the owner-only invite page (not used yet).
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# The seeded Owner (user 1) is claimed by, and always allowed to sign up with, this verified email.
OWNER_EMAIL=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=   # Cloudflare Turnstile site key; enable CAPTCHA in Supabase before hosting publicly

# App database (Postgres, schema screener_app; apply db/migrations first: python -m db.migrate). Use the dev Supabase project's
# Session pooler (5432), or any local Postgres 15+. Production uses the Transaction pooler (6543) — see .env.production.example.
APP_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Only for an engine deployed elsewhere (leave empty for the local engine): must match the engine's ENGINE_TOKEN
ENGINE_TOKEN=
